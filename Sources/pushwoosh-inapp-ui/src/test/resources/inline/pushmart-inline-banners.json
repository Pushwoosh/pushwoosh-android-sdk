  "shop_grid": {
    "bannerId": "autumn_drop",
    "version": 2,
    "format": "html",
    "action": {
      "type": "postEvent",
      "event": "inline_autumn_drop"
    },
    "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<style>\n:root { --card: #FFF1E6; --ink: #1D1A24; --muted: #6E6878; --accent: #FF4F2E; --chip: #FFFFFF; }\n@media (prefers-color-scheme: dark) {\n  :root { --card: #2A1C14; --ink: #F6F1EC; --muted: #BDB1A8; --accent: #FF7A57; --chip: #3D2A1F; }\n}\nhtml, body { margin: 0; padding: 0; background: transparent; }\nbody { font-family: -apple-system, system-ui, sans-serif; color: var(--ink); padding: 8px 0; }\n.card { background: var(--card); border-radius: 22px; padding: 18px 18px 16px; }\n.top { display: flex; align-items: center; justify-content: space-between; }\n.tag { background: var(--chip); color: var(--accent); font-size: 12px; font-weight: 800; letter-spacing: .6px; padding: 5px 10px; border-radius: 999px; }\n.close { border: 0; background: var(--chip); color: var(--muted); width: 30px; height: 30px; border-radius: 15px; font-size: 15px; }\nh2 { font-size: 21px; line-height: 1.2; margin: 14px 0 6px; }\np { font-size: 14px; line-height: 1.45; color: var(--muted); margin: 0 0 14px; }\na { color: var(--accent); font-weight: 700; font-size: 15px; text-decoration: none; }\n</style>\n</head>\n<body>\n<div class=\"card\">\n  <div class=\"top\">\n    <span class=\"tag\">AUTUMN DROP</span>\n    <button class=\"close\" onclick=\"pushwoosh.closeInApp()\">&#x2715;</button>\n  </div>\n  <h2>Outerwear 30% off this weekend</h2>\n  <p>An HTML banner from the campaign. A tap on the card posts its event; the link opens in the browser and the banner stays.</p>\n  <a data-pw-id=\"shop_lookbook\" href=\"https://www.pushwoosh.com\">See the lookbook &rsaquo;</a>\n</div>\n</body>\n</html>\n"
  },

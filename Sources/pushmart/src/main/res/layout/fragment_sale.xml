<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <View
        android:id="@+id/glow_a"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="center"
        android:translationX="-110dp" />

    <View
        android:id="@+id/glow_b"
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:layout_gravity="center"
        android:translationX="130dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="56dp" />

        <FrameLayout
            android:id="@+id/ticker_band"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginStart="-48dp"
            android:layout_marginEnd="-48dp"
            android:background="@color/pm_white"
            android:rotation="-3">

            <HorizontalScrollView
                android:id="@+id/ticker_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/ticker"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:letterSpacing="0.107"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.PushMart.Display"
                    android:textSize="14sp" />
            </HorizontalScrollView>
        </FrameLayout>

        <TextView
            android:id="@+id/new_season"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.19"
            android:text="@string/sale_new_season"
            android:textAppearance="@style/TextAppearance.PushMart.Label"
            android:textColor="@color/pm_white_85"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/title_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/title_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title_top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    android:textAppearance="@style/TextAppearance.PushMart.Display"
                    android:textColor="@color/pm_white"
                    android:textSize="66sp" />

                <TextView
                    android:id="@+id/title_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-10dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    android:textAppearance="@style/TextAppearance.PushMart.Display"
                    android:textColor="@color/pm_white"
                    android:textSize="66sp" />
            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <ImageView
                android:id="@+id/symbol"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <TextView
            android:id="@+id/blurb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.PushMart.Headline"
            android:textColor="@color/pm_white_90"
            android:textSize="17sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/picks"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:layout_marginStart="-28dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="-28dp"
            android:clipToPadding="false"
            android:paddingStart="28dp"
            android:paddingEnd="14dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shop_button"
            style="@style/Widget.PushMart.IconButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_pill_white"
            android:elevation="10dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:text="@string/orders_start_shopping"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_arrow_right"
            app:iconGravity="textEnd" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_circle_white_18_stroke"
        android:contentDescription="@string/close"
        android:padding="12dp"
        android:src="@drawable/ic_close"
        android:tint="@color/pm_white" />
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/perk_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_surface"
        android:elevation="2dp"
        android:importantForAccessibility="no"
        android:padding="12dp"
        app:tint="@color/pm_text_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/perk_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PushMart.Headline"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/perk_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.PushMart.Body"
            android:textColor="@color/pm_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>

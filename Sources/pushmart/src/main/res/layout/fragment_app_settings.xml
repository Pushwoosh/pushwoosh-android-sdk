<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/pm_screen_padding"
        android:paddingTop="@dimen/pm_screen_padding"
        android:paddingEnd="@dimen/pm_screen_padding"
        android:paddingBottom="40dp">

        <include
            android:id="@+id/back_button"
            layout="@layout/view_back_button" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_title"
            android:textAppearance="@style/TextAppearance.PushMart.PageTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_subtitle"
            android:textAppearance="@style/TextAppearance.PushMart.PageSubtitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/settings_appearance"
            android:textAppearance="@style/TextAppearance.PushMart.SectionTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_appearance_note"
            android:textAppearance="@style/TextAppearance.PushMart.Body"
            android:textColor="@color/pm_text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/appearance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill_secondary"
            android:padding="4dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.pushwoosh.pushmart.ui.common.SegmentButton
                android:id="@+id/theme_system"
                style="@style/Widget.PushMart.Segment"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:saveEnabled="false"
                android:text="@string/theme_system" />

            <com.pushwoosh.pushmart.ui.common.SegmentButton
                android:id="@+id/theme_light"
                style="@style/Widget.PushMart.Segment"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:saveEnabled="false"
                android:text="@string/theme_light" />

            <com.pushwoosh.pushmart.ui.common.SegmentButton
                android:id="@+id/theme_dark"
                style="@style/Widget.PushMart.Segment"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:saveEnabled="false"
                android:text="@string/theme_dark" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/settings_alerts"
            android:textAppearance="@style/TextAppearance.PushMart.SectionTitle" />

        <include
            android:id="@+id/alerts_row"
            layout="@layout/view_page_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

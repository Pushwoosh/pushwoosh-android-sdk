<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/pm_tab_clearance">

    <LinearLayout
        android:id="@+id/orders_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/pm_screen_padding"
            android:paddingTop="10dp"
            android:paddingEnd="@dimen/pm_screen_padding">

            <TextView
                android:id="@+id/orders_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.02"
                android:text="@string/orders_title"
                android:textAppearance="@style/TextAppearance.PushMart.Display"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/orders_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.PushMart.Body"
                android:textColor="@color/pm_text_secondary"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/orders_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/pm_screen_padding"
            android:paddingTop="28dp"
            android:paddingEnd="@dimen/pm_screen_padding"
            android:paddingBottom="28dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_circle_surface_hi"
                android:importantForAccessibility="no"
                android:padding="24dp"
                android:src="@drawable/ic_tab_shop_outline"
                app:tint="@color/pm_text_primary" />

            <TextView
                android:id="@+id/orders_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/orders_empty_title"
                android:textAppearance="@style/TextAppearance.PushMart.Title"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/orders_empty_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/orders_empty_body"
                android:textAppearance="@style/TextAppearance.PushMart.Body"
                android:textColor="@color/pm_text_secondary"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/orders_start_shopping"
                style="@style/Widget.PushMart.Button.Coral"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/orders_start_shopping" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/orders_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/more_for_you"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical"
            android:paddingStart="@dimen/pm_screen_padding"
            android:paddingEnd="@dimen/pm_screen_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/more_for_you"
                android:textAppearance="@style/TextAppearance.PushMart.Title"
                android:textSize="22sp" />

            <include
                android:id="@+id/more_drops"
                layout="@layout/view_more_row" />

            <View
                android:id="@+id/more_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="58dp"
                android:background="@color/pm_stroke" />

            <include
                android:id="@+id/more_picks"
                layout="@layout/view_more_row" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

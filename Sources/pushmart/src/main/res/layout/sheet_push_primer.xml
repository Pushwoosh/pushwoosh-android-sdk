<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="0dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        app:tint="@color/pm_text_tertiary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/pm_screen_padding"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/pm_screen_padding"
            android:paddingBottom="28dp">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_primer_hero"
                android:importantForAccessibility="no"
                android:padding="32dp"
                android:src="@drawable/ic_notifications_active"
                app:tint="@color/pm_white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/primer_title"
                android:textAppearance="@style/TextAppearance.PushMart.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/primer_message"
                android:textAppearance="@style/TextAppearance.PushMart.Body"
                android:textColor="@color/pm_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primer_accept"
                style="@style/Widget.PushMart.IconButton.Coral"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="@string/primer_accept"
                android:textColor="@color/pm_on_brand"
                app:cornerRadius="@dimen/pm_radius_field" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primer_decline"
                style="@style/Widget.PushMart.IconButton.Secondary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="@string/primer_decline"
                app:cornerRadius="@dimen/pm_radius_field" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/pm_screen_padding"
        android:paddingTop="@dimen/pm_screen_padding"
        android:paddingEnd="@dimen/pm_screen_padding"
        android:paddingBottom="40dp">

        <include
            android:id="@+id/back_button"
            layout="@layout/view_back_button" />

        <FrameLayout
            android:id="@+id/avatar_button"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:contentDescription="@string/your_details_change_photo"
            android:focusable="true">

            <ImageView
                android:id="@+id/avatar_image"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_circle_surface_hi"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/avatar_initial"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.PushMart.Display"
                android:textColor="@color/pm_text_secondary"
                android:textSize="30sp"
                android:visibility="gone" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_circle_surface"
                android:elevation="2dp"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_photo_camera"
                app:tint="@color/pm_text_primary" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/your_details_title"
            android:textAppearance="@style/TextAppearance.PushMart.PageTitle" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.PushMart.PageSubtitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/your_details_contact"
            android:textAppearance="@style/TextAppearance.PushMart.SectionTitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/email_input"
            android:text="@string/your_details_email"
            android:textAppearance="@style/TextAppearance.PushMart.FieldLabel" />

        <EditText
            android:id="@+id/email_input"
            style="@style/Widget.PushMart.PageField"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="@string/your_details_email_hint"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/your_details_order_updates"
            android:textAppearance="@style/TextAppearance.PushMart.SectionTitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/sms_input"
            android:text="@string/your_details_sms"
            android:textAppearance="@style/TextAppearance.PushMart.FieldLabel" />

        <EditText
            android:id="@+id/sms_input"
            style="@style/Widget.PushMart.PageField"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="@string/your_details_phone_hint"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="phone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@id/whatsapp_input"
            android:text="@string/your_details_whatsapp"
            android:textAppearance="@style/TextAppearance.PushMart.FieldLabel" />

        <EditText
            android:id="@+id/whatsapp_input"
            style="@style/Widget.PushMart.PageField"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="@string/your_details_phone_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="phone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/your_details_numbers_note"
            android:textAppearance="@style/TextAppearance.PushMart.Body"
            android:textColor="@color/pm_text_tertiary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save"
            style="@style/Widget.PushMart.IconButton.Coral"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="36dp"
            android:text="@string/your_details_save" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

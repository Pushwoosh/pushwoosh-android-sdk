<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/pm_screen_padding">

        <include
            android:id="@+id/back_button"
            layout="@layout/view_back_button" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Account"
            android:textAppearance="@style/TextAppearance.PushMart.Display"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your membership &amp; identity"
            android:textAppearance="@style/TextAppearance.PushMart.Body"
            android:textColor="@color/pm_text_secondary"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_member_card"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.2"
                android:text="PUSHMART"
                android:textColor="@color/pm_on_brand"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:alpha="0.55"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.25"
                android:text="MEMBER"
                android:textColor="@color/pm_on_brand"
                android:textSize="9sp" />

            <View
                android:layout_width="44dp"
                android:layout_height="33dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginBottom="30dp"
                android:background="@drawable/bg_card_chip_gold" />

            <TextView
                android:id="@+id/member_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginTop="40dp"
                android:fontFamily="monospace"
                android:textColor="@color/pm_on_brand"
                android:textSize="21sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.55"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.25"
                    android:text="MEMBER"
                    android:textColor="@color/pm_on_brand"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/card_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.PushMart.Label"
                    android:textColor="@color/pm_on_brand" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_bag"
                android:tint="@color/pm_on_brand" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/pm_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your details"
                android:textAppearance="@style/TextAppearance.PushMart.Headline" />

            <EditText
                android:id="@+id/name_input"
                style="@style/Widget.PushMart.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:drawableStart="@drawable/ic_person"
                android:hint="YOUR NAME"
                android:inputType="textPersonName|textCapWords" />

            <EditText
                android:id="@+id/member_id_input"
                style="@style/Widget.PushMart.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:drawableStart="@drawable/ic_account_circle"
                android:hint="MEMBER ID"
                android:inputType="text" />

            <EditText
                android:id="@+id/email_input"
                style="@style/Widget.PushMart.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:drawableStart="@drawable/ic_mail"
                android:hint="EMAIL"
                android:imeOptions="actionDone"
                android:inputType="textEmailAddress" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/save"
                style="@style/Widget.PushMart.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:drawableStart="@drawable/ic_check"
                android:text="Save changes" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Your member ID and email tell PushMart who you are, so orders, offers and rewards follow you across devices."
                android:textAppearance="@style/TextAppearance.PushMart.Body"
                android:textColor="@color/pm_text_tertiary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

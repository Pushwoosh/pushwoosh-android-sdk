<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/pm_screen_padding"
        android:paddingTop="@dimen/pm_screen_padding"
        android:paddingEnd="@dimen/pm_screen_padding"
        android:paddingBottom="40dp">

        <include
            android:id="@+id/back_button"
            layout="@layout/view_back_button" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reminders_title"
            android:textAppearance="@style/TextAppearance.PushMart.PageTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/reminders_subtitle"
            android:textAppearance="@style/TextAppearance.PushMart.PageSubtitle" />

        <LinearLayout
            android:id="@+id/enable_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_panel_surface_hi"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/push_notifications"
                android:textAppearance="@style/TextAppearance.PushMart.Headline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/reminders_enable_body"
                android:textAppearance="@style/TextAppearance.PushMart.Body"
                android:textColor="@color/pm_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/enable_button"
                style="@style/Widget.PushMart.IconButton.Coral"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/reminders_enable"
                app:icon="@drawable/ic_bell" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/reminders_preview"
            android:textAppearance="@style/TextAppearance.PushMart.SectionTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_surface_hi"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_app_icon"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/ic_tab_shop_filled"
                app:tint="@color/pm_ink" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/app_name"
                        android:textAppearance="@style/TextAppearance.PushMart.Label"
                        android:textColor="@color/pm_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/preview_delay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textAppearance="@style/TextAppearance.PushMart.Body"
                        android:textColor="@color/pm_text_tertiary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/preview_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.PushMart.Headline"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/preview_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.PushMart.Body"
                    android:textColor="@color/pm_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/reminders_about"
            android:textAppearance="@style/TextAppearance.PushMart.SectionTitle" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="-20dp"
            android:clipToPadding="false"
            android:paddingStart="@dimen/pm_screen_padding"
            android:paddingEnd="@dimen/pm_screen_padding"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/reminder_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/reminders_when"
            android:textAppearance="@style/TextAppearance.PushMart.SectionTitle" />

        <include
            android:id="@+id/wheel"
            layout="@layout/view_duration_wheel"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/remind_me"
            style="@style/Widget.PushMart.IconButton.Coral"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="@string/reminders_remind_me"
            app:icon="@drawable/ic_notifications_active" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/reminders_footnote"
            android:textAppearance="@style/TextAppearance.PushMart.Body"
            android:textColor="@color/pm_text_tertiary"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/pm_screen_padding"
        android:paddingTop="@dimen/pm_screen_padding"
        android:paddingEnd="@dimen/pm_screen_padding"
        android:paddingBottom="40dp">

        <include
            android:id="@+id/back_button"
            layout="@layout/view_back_button" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/notifications_title"
            android:textAppearance="@style/TextAppearance.PushMart.PageTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/notifications_subtitle"
            android:textAppearance="@style/TextAppearance.PushMart.PageSubtitle" />

        <LinearLayout
            android:id="@+id/off_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_panel_surface_hi"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:padding="18dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_surface"
                android:elevation="2dp"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:src="@drawable/ic_bell_off"
                app:tint="@color/pm_text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notifications_off_title"
                    android:textAppearance="@style/TextAppearance.PushMart.Headline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/notifications_off_body"
                    android:textAppearance="@style/TextAppearance.PushMart.Body"
                    android:textColor="@color/pm_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/push_notifications"
            android:textAppearance="@style/TextAppearance.PushMart.SectionTitle" />

        <include
            android:id="@+id/push_row"
            layout="@layout/view_page_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

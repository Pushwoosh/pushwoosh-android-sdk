<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/pm_screen_padding">

        <include
            android:id="@+id/back_button"
            layout="@layout/view_back_button" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Notifications"
            android:textAppearance="@style/TextAppearance.PushMart.Display"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What lands on your Lock Screen"
            android:textAppearance="@style/TextAppearance.PushMart.Body"
            android:textColor="@color/pm_text_secondary"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:id="@+id/previews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/sample_1"
                    layout="@layout/view_push_sample" />

                <include
                    android:id="@+id/sample_2"
                    layout="@layout/view_push_sample" />

                <include
                    android:id="@+id/sample_3"
                    layout="@layout/view_push_sample" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/previews_off"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_bell_off"
                    android:tint="@color/pm_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Notifications are off"
                    android:textAppearance="@style/TextAppearance.PushMart.Headline"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Turn them on to get order updates,\ndrops and members-only deals."
                    android:textAppearance="@style/TextAppearance.PushMart.Body"
                    android:textColor="@color/pm_text_secondary"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/turn_on"
                    style="@style/Widget.PushMart.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="Turn on" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/pm_card_padding">

            <ImageView
                android:id="@+id/status_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_bell"
                android:tint="@color/pm_coral" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Push notifications"
                    android:textAppearance="@style/TextAppearance.PushMart.Headline"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.PushMart.Body"
                    android:textColor="@color/pm_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/push_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/pm_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delivery details"
                android:textAppearance="@style/TextAppearance.PushMart.Headline" />

            <include
                android:id="@+id/row_permission"
                layout="@layout/view_detail_row" />

            <include
                android:id="@+id/row_token"
                layout="@layout/view_detail_row" />

            <include
                android:id="@+id/row_hwid"
                layout="@layout/view_detail_row" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/reregister"
                style="@style/Widget.PushMart.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:drawableStart="@drawable/ic_bell"
                android:text="Re-register this device" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/unregister"
                style="@style/Widget.PushMart.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:drawableStart="@drawable/ic_bell_off"
                android:text="Unregister" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

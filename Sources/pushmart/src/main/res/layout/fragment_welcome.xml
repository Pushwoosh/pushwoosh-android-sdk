<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/pm_screen_padding">

        <FrameLayout
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_rounded_brand_28">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bag"
                android:tint="@color/pm_on_brand" />
        </FrameLayout>

        <include
            android:id="@+id/wordmark"
            layout="@layout/view_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Shop what's next."
            android:textAppearance="@style/TextAppearance.PushMart.Display"
            android:textSize="38sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Exclusive drops, live order tracking and deals picked just for you."
            android:textAppearance="@style/TextAppearance.PushMart.Body"
            android:textColor="@color/pm_text_secondary"
            android:textSize="16sp" />

        <include
            android:id="@+id/perk_delivery"
            layout="@layout/view_perk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />

        <include
            android:id="@+id/perk_drops"
            layout="@layout/view_perk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/perk_deals"
            layout="@layout/view_perk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/get_started"
            style="@style/Widget.PushMart.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:drawableEnd="@drawable/ic_arrow_right"
            android:text="Get started" />
    </LinearLayout>
</ScrollView>

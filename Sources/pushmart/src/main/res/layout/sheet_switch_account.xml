<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/pm_screen_padding">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Switch account"
        android:textAppearance="@style/TextAppearance.PushMart.Display"
        android:textSize="28sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Connect to a different Pushwoosh app. This unregisters the current device, switches the app code, then registers again."
        android:textAppearance="@style/TextAppearance.PushMart.Body"
        android:textColor="@color/pm_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Connect to a project by app code"
        android:textAppearance="@style/TextAppearance.PushMart.Headline"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/code_input"
        style="@style/Widget.PushMart.Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:drawableStart="@drawable/ic_qr"
        android:hint="App code (XXXXX-XXXXX)"
        android:inputType="textCapCharacters|textNoSuggestions" />

    <EditText
        android:id="@+id/name_input"
        style="@style/Widget.PushMart.Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:drawableStart="@drawable/ic_person"
        android:hint="Name (optional)"
        android:inputType="textPersonName|textCapWords" />

    <EditText
        android:id="@+id/email_input"
        style="@style/Widget.PushMart.Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:drawableStart="@drawable/ic_mail"
        android:hint="Email (optional)"
        android:imeOptions="actionDone"
        android:inputType="textEmailAddress" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/switch_button"
        style="@style/Widget.PushMart.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:drawableStart="@drawable/ic_swap"
        android:text="Switch account" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Tip: the current app code is prefilled. Enter another to connect to a different project."
        android:textAppearance="@style/TextAppearance.PushMart.Body"
        android:textColor="@color/pm_text_tertiary"
        android:textSize="12sp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/pm_screen_padding">

        <include
            android:id="@+id/back_button"
            layout="@layout/view_back_button" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Rich media"
            android:textAppearance="@style/TextAppearance.PushMart.Display"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HTML rich media from campaigns: display mode, style, server triggers"
            android:textAppearance="@style/TextAppearance.PushMart.Body"
            android:textColor="@color/pm_text_secondary"
            android:textSize="14sp" />

        <!-- Display mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/pm_card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Modal display mode"
                        android:textAppearance="@style/TextAppearance.PushMart.Headline" />

                    <TextView
                        android:id="@+id/mode_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.PushMart.Body"
                        android:textColor="@color/pm_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/modal_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Modal rich media" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Off: legacy full-screen activity. On: a window over the current screen. Applies to the next rich media and survives restarts. Native in-app layouts (In-app showcase) are a separate pipeline and are not affected."
                android:textAppearance="@style/TextAppearance.PushMart.Body"
                android:textColor="@color/pm_text_tertiary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Style -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/pm_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modal style"
                android:textAppearance="@style/TextAppearance.PushMart.Headline" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Position">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/position"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="Position"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Present animation">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/present_animation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="Present animation"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Dismiss animation">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/dismiss_animation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="Dismiss animation"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Window width">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/window_width"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="Window width"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Swipe to dismiss"
                android:textAppearance="@style/TextAppearance.PushMart.Label"
                android:textColor="@color/pm_text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/swipe_up"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="Swipe up"
                    android:text="Up" />

                <CheckBox
                    android:id="@+id/swipe_left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="Swipe left"
                    android:text="Left" />

                <CheckBox
                    android:id="@+id/swipe_right"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="Swipe right"
                    android:text="Right" />

                <CheckBox
                    android:id="@+id/swipe_down"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="Swipe down"
                    android:text="Down" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Animation duration"
                android:textAppearance="@style/TextAppearance.PushMart.Label"
                android:textColor="@color/pm_text_secondary" />

            <RadioGroup
                android:id="@+id/duration_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/duration_300"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="Animation 300 ms"
                    android:text="300 ms" />

                <RadioButton
                    android:id="@+id/duration_600"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="Animation 600 ms"
                    android:text="600 ms" />

                <RadioButton
                    android:id="@+id/duration_1000"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="Animation 1000 ms"
                    android:text="1000 ms" />
            </RadioGroup>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Color scheme">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/color_scheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="Color scheme"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Position, animations, width, swipes and duration apply to modal rich media only. Color scheme applies to rich media and to native in-app: the Modal preset in In-app showcase has a dark variant."
                android:textAppearance="@style/TextAppearance.PushMart.Body"
                android:textColor="@color/pm_text_tertiary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Server triggers -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/pm_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server triggers"
                android:textAppearance="@style/TextAppearance.PushMart.Headline" />

            <TextView
                android:id="@+id/triggers_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.PushMart.Body"
                android:textColor="@color/pm_text_secondary"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/trigger_show_rich_media"
                style="@style/Widget.PushMart.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:contentDescription="Trigger showRichMedia"
                android:drawableStart="@drawable/ic_bolt"
                android:text="showRichMedia" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/trigger_show_rich_media_client"
                style="@style/Widget.PushMart.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:contentDescription="Trigger showRichMediaClient"
                android:drawableStart="@drawable/ic_bolt"
                android:text="showRichMediaClient" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/trigger_show_rich_media_server"
                style="@style/Widget.PushMart.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:contentDescription="Trigger showRichMediaServer"
                android:drawableStart="@drawable/ic_bolt"
                android:text="showRichMediaServer" />

            <TextView
                android:id="@+id/trigger_outcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:contentDescription="Trigger outcome"
                android:textAppearance="@style/TextAppearance.PushMart.Body"
                android:textColor="@color/pm_text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

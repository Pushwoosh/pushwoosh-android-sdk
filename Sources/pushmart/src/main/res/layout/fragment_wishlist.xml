<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/pm_screen_padding"
    android:paddingTop="@dimen/pm_screen_padding"
    android:paddingEnd="@dimen/pm_screen_padding">

    <include
        android:id="@+id/back_button"
        layout="@layout/view_back_button" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Wishlist"
        android:textAppearance="@style/TextAppearance.PushMart.Display"
        android:textSize="32sp" />

    <LinearLayout
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_heart_outline"
            android:tint="@color/pm_text_tertiary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Nothing saved yet"
            android:textAppearance="@style/TextAppearance.PushMart.Title"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Tap the heart on any product to keep it here."
            android:textAppearance="@style/TextAppearance.PushMart.Body"
            android:textColor="@color/pm_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="-6dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="-6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />
</LinearLayout>

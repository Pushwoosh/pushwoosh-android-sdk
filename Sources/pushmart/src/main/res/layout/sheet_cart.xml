<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/state_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_bag"
            android:tint="@color/pm_text_tertiary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Your bag is empty"
            android:textAppearance="@style/TextAppearance.PushMart.Title"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Browse the shop and add something you love."
            android:textAppearance="@style/TextAppearance.PushMart.Body"
            android:textColor="@color/pm_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/state_filled"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/pm_screen_padding"
            android:layout_marginTop="@dimen/pm_screen_padding"
            android:layout_marginBottom="8dp"
            android:text="Your bag"
            android:textAppearance="@style/TextAppearance.PushMart.Display"
            android:textSize="28sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/pm_ink2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/pm_screen_padding">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total"
                    android:textAppearance="@style/TextAppearance.PushMart.Headline"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.PushMart.Title" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/checkout"
                style="@style/Widget.PushMart.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_credit_card"
                android:text="Checkout" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/state_placed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:src="@drawable/ic_check_circle"
            android:tint="@color/pm_success" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Order placed!"
            android:textAppearance="@style/TextAppearance.PushMart.Display"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="We'll keep you posted with push updates on your order."
            android:textAppearance="@style/TextAppearance.PushMart.Body"
            android:textColor="@color/pm_text_secondary" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/keep_shopping"
            style="@style/Widget.PushMart.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Keep shopping" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_circle_stroke_strong"
        android:contentDescription="Close"
        android:padding="10dp"
        android:src="@drawable/ic_close"
        android:tint="@color/pm_text_primary" />
</FrameLayout>

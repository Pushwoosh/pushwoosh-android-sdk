<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pm_ink">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="64dp"
        android:paddingBottom="@dimen/pm_grid_clearance" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_bar"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                android:tint="@color/pm_text_secondary" />

            <EditText
                android:id="@+id/search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/shop_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text|textNoSuggestions"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.PushMart.Body"
                android:textColor="@color/pm_text_primary"
                android:textColorHint="@color/pm_text_tertiary"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/clear_search"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/shop_clear_search"
                android:src="@drawable/ic_cancel"
                android:tint="@color/pm_text_tertiary"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:clipChildren="false">

            <ImageButton
                android:id="@+id/cart_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_tab_bar"
                android:contentDescription="@string/shop_bag"
                android:elevation="6dp"
                android:padding="13dp"
                android:src="@drawable/ic_tab_shop_outline"
                android:tint="@color/pm_text_primary" />

            <TextView
                android:id="@+id/cart_badge"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_bag_badge"
                android:elevation="7dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:minWidth="22dp"
                android:outlineProvider="none"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@color/pm_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:translationX="6dp"
                android:translationY="-6dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>

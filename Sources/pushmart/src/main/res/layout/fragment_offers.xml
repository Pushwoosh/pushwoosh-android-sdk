<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pm_ink"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:letterSpacing="-0.02"
                android:minHeight="48dp"
                android:text="@string/tab_inbox"
                android:textAppearance="@style/TextAppearance.PushMart.Display"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/inbox_subtitle_default"
                android:textAppearance="@style/TextAppearance.PushMart.Body"
                android:textColor="@color/pm_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_tab_bar"
            android:contentDescription="@string/inbox_more"
            android:elevation="6dp"
            android:padding="15dp"
            android:src="@drawable/ic_more_horiz"
            android:tint="@color/pm_text_primary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/inbox_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/pm_ink"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingBottom="@dimen/pm_tab_clearance"
            android:visibility="gone">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_tab_bar"
                android:elevation="6dp"
                android:importantForAccessibility="no"
                android:padding="29dp"
                android:src="@drawable/ic_tab_inbox_outline"
                android:tint="@color/pm_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:letterSpacing="-0.014"
                android:text="@string/inbox_empty_title"
                android:textAppearance="@style/TextAppearance.PushMart.Display"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/inbox_empty_body"
                android:textAppearance="@style/TextAppearance.PushMart.Body"
                android:textColor="@color/pm_text_secondary"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/empty_refresh"
                style="@style/Widget.PushMart.Button.Coral"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="40dp"
                android:paddingStart="32dp"
                android:paddingTop="0dp"
                android:paddingEnd="32dp"
                android:paddingBottom="0dp"
                android:text="@string/inbox_empty_refresh"
                android:textAppearance="@style/TextAppearance.PushMart.Headline"
                android:textSize="17sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

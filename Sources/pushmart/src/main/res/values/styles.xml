<resources>
    <style name="TextAppearance.PushMart.Display" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">@color/pm_text_primary</item>
    </style>
    <style name="TextAppearance.PushMart.Title" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/pm_text_primary</item>
    </style>
    <style name="TextAppearance.PushMart.Headline" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/pm_text_primary</item>
    </style>
    <style name="TextAppearance.PushMart.Body" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/pm_text_primary</item>
    </style>
    <style name="TextAppearance.PushMart.Label" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/pm_text_primary</item>
    </style>
    <!-- iOS PushMartPageHeader / PushMartPageSection / PushMartPageRow -->
    <style name="TextAppearance.PushMart.PageTitle" parent="TextAppearance.PushMart.Display">
        <item name="android:textSize">40sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.PushMart.PageSubtitle" parent="TextAppearance.PushMart.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/pm_text_secondary</item>
    </style>
    <style name="TextAppearance.PushMart.SectionTitle" parent="TextAppearance.PushMart.Title">
        <item name="android:textSize">22sp</item>
    </style>
    <style name="TextAppearance.PushMart.RowTitle" parent="TextAppearance.PushMart.Headline">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.PushMart.RowDetail" parent="TextAppearance.PushMart.Body">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/pm_text_secondary</item>
    </style>
    <style name="TextAppearance.PushMart.FieldLabel" parent="TextAppearance.PushMart.Label">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/pm_text_secondary</item>
    </style>
    <style name="TextAppearance.PushMart.Mono" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/pm_text_primary</item>
    </style>
    <style name="TextAppearance.PushMart.Badge" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/pm_white</item>
    </style>

    <!-- Capsule buttons; use androidx.appcompat.widget.AppCompatButton so Material does not replace the background -->
    <style name="Widget.PushMart.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:drawablePadding">8dp</item>
    </style>
    <style name="Widget.PushMart.Button.Primary">
        <item name="android:background">@drawable/bg_pill_brand</item>
        <item name="android:textColor">@color/pm_on_brand</item>
        <item name="android:drawableTint">@color/pm_on_brand</item>
    </style>
    <style name="Widget.PushMart.Button.Ghost">
        <item name="android:background">@drawable/bg_pill_ghost</item>
        <item name="android:textColor">@color/pm_coral</item>
        <item name="android:drawableTint">@color/pm_coral</item>
    </style>
    <style name="Widget.PushMart.Button.Coral">
        <item name="android:background">@drawable/bg_pill_coral</item>
        <item name="android:textColor">@color/pm_white</item>
        <item name="android:drawableTint">@color/pm_white</item>
    </style>
    <style name="Widget.PushMart.Button.Glass">
        <item name="android:background">@drawable/bg_tab_bar</item>
        <item name="android:textColor">@color/pm_text_primary</item>
        <item name="android:drawableTint">@color/pm_text_primary</item>
    </style>

    <!-- MaterialButton capsules: icon and label are centred together, as on iOS. -->
    <style name="Widget.PushMart.IconButton" parent="Widget.Material3.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
    </style>
    <style name="Widget.PushMart.IconButton.Coral">
        <item name="backgroundTint">@color/pm_coral</item>
        <item name="android:textColor">@color/pm_white</item>
        <item name="iconTint">@color/pm_white</item>
    </style>
    <style name="Widget.PushMart.IconButton.Brand">
        <item name="android:background">@drawable/bg_pill_brand</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/pm_on_brand</item>
        <item name="iconTint">@color/pm_on_brand</item>
        <item name="android:textSize">16sp</item>
        <item name="iconSize">18dp</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
    </style>
    <style name="Widget.PushMart.IconButton.Secondary">
        <item name="backgroundTint">@color/pm_surface_hi</item>
        <item name="strokeColor">@color/pm_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/pm_text_primary</item>
        <item name="iconTint">@color/pm_text_primary</item>
    </style>

    <!-- iOS segmented control: a pm_surface capsule marks the checked segment on a pm_surface_hi track -->
    <style name="Widget.PushMart.Segment" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/pm_text_primary</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@color/pm_segment_fill</item>
        <item name="rippleColor">@color/pm_stroke</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <style name="Widget.PushMart.Field" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/pm_text_primary</item>
        <item name="android:textColorHint">@color/pm_text_tertiary</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableTint">@color/pm_text_tertiary</item>
        <item name="android:maxLines">1</item>
        <item name="android:inputType">text</item>
    </style>

    <!-- iOS PushMartPageField -->
    <style name="Widget.PushMart.PageField" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_page_field</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textAppearance">@style/TextAppearance.PushMart.Body</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/pm_text_primary</item>
        <item name="android:textColorHint">@color/pm_text_tertiary</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Widget.PushMart.Chip" parent="">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/pm_chip_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Solid capsule chip with a leading icon tinted like the text (iOS Reminders chips) -->
    <style name="Widget.PushMart.Chip.Solid">
        <item name="android:background">@drawable/bg_chip_solid</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:drawablePadding">6dp</item>
    </style>

    <!-- Brand capsule chip, as iOS PushMartChip: the leading check is tinted like the text -->
    <style name="Widget.PushMart.Chip.Brand">
        <item name="android:background">@drawable/bg_chip_brand</item>
        <item name="android:textColor">@color/pm_chip_brand_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:drawablePadding">6dp</item>
    </style>

    <style name="ShapeAppearance.PushMart.Rounded12" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.PushMart.Rounded14" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
    <style name="ShapeAppearance.PushMart.Rounded16" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.PushMart.Rounded18" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
    <style name="ShapeAppearance.PushMart.Rounded20" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeAppearance.PushMart.Rounded24" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
    <style name="ShapeAppearance.PushMart.Rounded28" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/pm_radius_order_card</item>
    </style>
    <style name="ShapeAppearance.PushMart.Rounded32" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">32dp</item>
    </style>

    <style name="Widget.PushMart.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/pm_tab_lens</item>
        <item name="android:width">60dp</item>
        <item name="android:height">52dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <style name="Widget.PushMart.LiveStageLabel" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/pm_live_stage_label</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>

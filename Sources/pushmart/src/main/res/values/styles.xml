<resources>
    <style name="TextAppearance.PushMart.Display" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">@color/pm_text_primary</item>
    </style>
    <style name="TextAppearance.PushMart.Title" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/pm_text_primary</item>
    </style>
    <style name="TextAppearance.PushMart.Headline" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/pm_text_primary</item>
    </style>
    <style name="TextAppearance.PushMart.Body" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/pm_text_primary</item>
    </style>
    <style name="TextAppearance.PushMart.Label" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/pm_text_primary</item>
    </style>

    <!-- Capsule buttons; use androidx.appcompat.widget.AppCompatButton so Material does not replace the background -->
    <style name="Widget.PushMart.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:drawablePadding">8dp</item>
    </style>
    <style name="Widget.PushMart.Button.Primary">
        <item name="android:background">@drawable/bg_pill_brand</item>
        <item name="android:textColor">@color/pm_on_brand</item>
        <item name="android:drawableTint">@color/pm_on_brand</item>
    </style>
    <style name="Widget.PushMart.Button.Secondary">
        <item name="android:background">@drawable/bg_pill_secondary</item>
        <item name="android:textColor">@color/pm_text_primary</item>
        <item name="android:drawableTint">@color/pm_text_primary</item>
    </style>
    <style name="Widget.PushMart.Button.Ghost">
        <item name="android:background">@drawable/bg_pill_ghost</item>
        <item name="android:textColor">@color/pm_coral</item>
        <item name="android:drawableTint">@color/pm_coral</item>
    </style>

    <style name="Widget.PushMart.Field" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/pm_text_primary</item>
        <item name="android:textColorHint">@color/pm_text_tertiary</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableTint">@color/pm_text_tertiary</item>
        <item name="android:maxLines">1</item>
        <item name="android:inputType">text</item>
    </style>

    <style name="Widget.PushMart.Chip" parent="">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/pm_chip_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ShapeAppearance.PushMart.Rounded14" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
    <style name="ShapeAppearance.PushMart.Rounded16" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.PushMart.Rounded18" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
    <style name="ShapeAppearance.PushMart.Rounded26" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">26dp</item>
    </style>

    <style name="Widget.PushMart.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/pm_coral_14</item>
    </style>
</resources>

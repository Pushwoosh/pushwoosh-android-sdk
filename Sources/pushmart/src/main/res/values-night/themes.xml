<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PushMart" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pm_coral</item>
        <item name="colorOnPrimary">@color/pm_on_brand</item>
        <item name="colorPrimaryContainer">@color/pm_coral_14</item>
        <item name="colorOnPrimaryContainer">@color/pm_text_primary</item>
        <item name="colorSecondary">@color/pm_tangerine</item>
        <item name="colorOnSecondary">@color/pm_on_brand</item>
        <item name="colorSecondaryContainer">@color/pm_coral_14</item>
        <item name="colorOnSecondaryContainer">@color/pm_text_primary</item>
        <item name="colorError">@color/pm_danger</item>
        <item name="android:colorBackground">@color/pm_ink</item>
        <item name="colorOnBackground">@color/pm_text_primary</item>
        <item name="colorSurface">@color/pm_surface</item>
        <item name="colorOnSurface">@color/pm_text_primary</item>
        <item name="colorSurfaceVariant">@color/pm_surface_hi</item>
        <item name="colorOnSurfaceVariant">@color/pm_text_secondary</item>
        <item name="colorOutline">@color/pm_stroke_strong</item>
        <item name="colorOutlineVariant">@color/pm_stroke</item>
        <item name="android:textColorPrimary">@color/pm_text_primary</item>
        <item name="android:textColorSecondary">@color/pm_text_secondary</item>
        <item name="android:textColorHint">@color/pm_text_tertiary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.PushMart.BottomSheet</item>
    </style>
</resources>

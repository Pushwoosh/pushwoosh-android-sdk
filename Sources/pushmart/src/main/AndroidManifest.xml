<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name="com.pushwoosh.pushmart.PushMartApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PushMart">

        <meta-data android:name="com.pushwoosh.log_level" android:value="${pushwooshLogLevel}" />
        <meta-data android:name="com.pushwoosh.notification_icon" android:value="@drawable/ic_stat_pushmart" />
        <meta-data android:name="com.pushwoosh.notification_icon_color" android:value="#FF5A5F" />
        <meta-data
            android:name="com.pushwoosh.notification_service_extension"
            android:value="com.pushwoosh.pushmart.PushMartNotificationServiceExtension" />
        <meta-data
            android:name="com.pushwoosh.LIVE_UPDATE_STYLE_PROVIDER"
            android:value="com.pushwoosh.pushmart.live.OrderLiveUpdateStyleProvider" />

        <activity
            android:name="com.pushwoosh.pushmart.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pushwoosh" />
                <data android:scheme="pushon-add-product" />
                <data android:scheme="pushon-open-tab" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="com.pushwoosh.pushmart.LauncherDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:targetActivity="com.pushwoosh.pushmart.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.pushwoosh.pushmart.LauncherXmasSale"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_xmas_sale"
            android:targetActivity="com.pushwoosh.pushmart.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name="com.pushwoosh.pushmart.live.DropAlarmReceiver"
            android:exported="false" />
    </application>

</manifest>

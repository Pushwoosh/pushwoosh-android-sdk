<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/pw_normal_margin"
    android:paddingLeft="@dimen/pw_normal_margin"
    android:paddingEnd="@dimen/pw_normal_margin"
    android:paddingRight="@dimen/pw_normal_margin"
    android:paddingTop="@dimen/pw_banner_margin_vertical"
    android:paddingBottom="@dimen/pw_banner_margin_vertical">

    <FrameLayout
        android:id="@+id/inboxBannerCard"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pw_banner_height"
        android:background="@drawable/pw_bg_banner_card">

        <ImageView
            android:id="@+id/inboxBannerHeroImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <View
            android:id="@+id/inboxBannerUnreadDot"
            android:layout_width="@dimen/pw_banner_unread_dot_size"
            android:layout_height="@dimen/pw_banner_unread_dot_size"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/pw_banner_unread_dot_offset"
            android:background="@drawable/pw_bg_banner_unread_dot" />

        <include
            android:id="@+id/inboxBannerPinChip"
            layout="@layout/pw_inbox_pin_chip"
            android:layout_width="@dimen/pw_banner_pin_chip_size"
            android:layout_height="@dimen/pw_banner_pin_chip_size"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/pw_banner_pin_chip_offset" />
    </FrameLayout>
</FrameLayout>

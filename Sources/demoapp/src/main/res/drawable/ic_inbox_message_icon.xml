<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Default message avatar (PushwooshInboxStyle.defaultImageIcon): a light disc punched out of the
  ~ tinted row, with the brand envelope inside. Used for every message with no icon of its own.
  -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/md_theme_surfaceContainerLowest" />
            <size
                android:width="108dp"
                android:height="108dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_inbox_envelope"
        android:gravity="center"
        android:width="46dp"
        android:height="46dp" />
</layer-list>

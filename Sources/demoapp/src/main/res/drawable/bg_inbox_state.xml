<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Read/unread stamp behind the message-type glyph. The SDK sets isSelected on inboxStatusImageView
  ~ for unread messages, so this selector is what turns state into a visible difference.
  -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/md_theme_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/md_theme_outlineVariant" />
        </shape>
    </item>
</selector>
